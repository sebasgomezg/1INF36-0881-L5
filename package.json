{
  "name": "avisa-campus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.js",
    "test": "node --test functions/tests/*.test.cjs tests/static.test.js tests/auth.test.js tests/notifications.test.js",
    "test:rules": "firebase emulators:exec --project demo-avisa-campus --only auth,firestore \"node --test tests/rules.test.js\"",
    "test:integration": "firebase emulators:exec --project demo-avisa-campus --only auth,firestore,functions \"node --test tests/integration.test.js\"",
    "test:browser": "python tests/browser.py",
    "emulators": "firebase emulators:start --project demo-avisa-campus",
    "seed": "node scripts/seed.cjs",
    "test:core": "firebase emulators:exec --project demo-avisa-campus --only firestore \"node --test tests/notification-core.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "12.13.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.1"
  }
}
