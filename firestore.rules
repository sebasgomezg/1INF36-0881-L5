rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function member(){return signed() && request.auth.token.firebase.sign_in_provider == 'password';}
    function admin() {
      return signed() && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function owner(id) { return signed() && get(/databases/$(database)/documents/autores/$(id)).data.uid == request.auth.uid; }
    function cleaning(id) { return admin() && exists(/databases/$(database)/documents/eliminaciones/$(id)); }
    function readable(id) {
      return get(/databases/$(database)/documents/incidentes/$(id)).data.visibilidad == 'publico' || admin() || owner(id);
    }
    function category(v) { return v in ['Infraestructura','Electricidad y enchufes','Equipos y laboratorios','Servicios','Limpieza','Seguridad y tránsito','Convivencia','Otro']; }
    function zone(v) { return v in ['Pabellón V','Estudios Generales Ciencias','Estudios Generales Letras','Biblioteca Central','Comedor Central','Polideportivo y canchas','Estacionamientos','Vías y áreas verdes','Otra zona']; }
    function state(v) { return v in ['reportado','revisando','en_atencion','resuelto','descartado']; }
    function incident(d, id) {
      return d.keys().hasAll(['titulo','categoria','zona','lugar','descripcion','codigo','creado','actualizado','visibilidad','estado','respuesta','confirmaciones','version','tieneFoto','mini'])
        && d.keys().hasOnly(['titulo','categoria','zona','lugar','descripcion','codigo','creado','actualizado','visibilidad','estado','respuesta','confirmaciones','version','tieneFoto','mini'])
        && d.titulo is string && d.titulo.size() >= 5 && d.titulo.size() <= 80
        && d.lugar is string && d.lugar.size() >= 1 && d.lugar.size() <= 80
        && d.descripcion is string && d.descripcion.size() <= 600 && category(d.categoria) && zone(d.zona)
        && d.codigo == 'AV-' + id.upper() && d.creado is timestamp && d.actualizado is timestamp
        && d.visibilidad in ['publico','revision'] && state(d.estado)
        && d.respuesta is string && d.respuesta.size() <= 1000
        && d.confirmaciones is int && d.confirmaciones >= 0 && d.version is int && d.version >= 0
        && d.tieneFoto is bool && ((!d.tieneFoto && d.mini == null) || (d.tieneFoto && d.mini is string && d.mini.size() <= 24000 && d.mini.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')));
    }
    function voteActiveBefore(id) {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)/votos/$(id))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)/votos/$(id)).data.activo;
    }
    function voteChange(id) {
      let before = voteActiveBefore(id);
      let after = getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)/votos/$(id)).data.activo;
      return member() && resource.data.visibilidad == 'publico' && after != before
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmaciones'])
        && request.resource.data.confirmaciones == resource.data.confirmaciones + (after ? 1 : -1);
    }
    match /incidentes/{id} {
      allow get, list: if resource.data.visibilidad == 'publico' || admin() || owner(id);
      allow create: if member() && incident(request.resource.data, id)
        && getAfter(/databases/$(database)/documents/autores/$(id)).data.uid == request.auth.uid
        && request.resource.data.visibilidad in ['publico','revision']
        && (!getAfter(/databases/$(database)/documents/autores/$(id)).data.persona || request.resource.data.visibilidad == 'revision')
        && request.resource.data.estado == 'reportado' && request.resource.data.respuesta == ''
        && request.resource.data.confirmaciones == 0 && request.resource.data.version == 0
        && request.resource.data.creado == request.time && request.resource.data.actualizado == request.time
        && (!request.resource.data.tieneFoto || getAfter(/databases/$(database)/documents/fotos/$(id)).data.data is string);
      allow update: if !exists(/databases/$(database)/documents/eliminaciones/$(id)) && incident(request.resource.data, id) && (voteChange(id) || (
        admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','respuesta','visibilidad','actualizado','version'])
        && request.resource.data.version == resource.data.version + 1 && request.resource.data.actualizado == request.time
        && getAfter(/databases/$(database)/documents/incidentes/$(id)/historial/$(request.resource.data.version)).data.estado == request.resource.data.estado
        && getAfter(/databases/$(database)/documents/incidentes/$(id)/historial/$(request.resource.data.version)).data.visibilidad == request.resource.data.visibilidad
        && getAfter(/databases/$(database)/documents/incidentes/$(id)/historial/$(request.resource.data.version)).data.respuesta == request.resource.data.respuesta
        && getAfter(/databases/$(database)/documents/incidentes/$(id)/historial/$(request.resource.data.version)).data.fecha == request.time
      ));
      allow delete: if cleaning(id);
      match /historial/{version} {
        allow read: if readable(id);
        allow create: if admin() && request.resource.data.keys().hasOnly(['accion','estado','visibilidad','respuesta','fecha'])
          && request.resource.data.accion in ['actualizar','aprobar','descartar']
          && getAfter(/databases/$(database)/documents/incidentes/$(id)).data.version == int(version)
          && get(/databases/$(database)/documents/incidentes/$(id)).data.version + 1 == int(version)
          && request.resource.data.estado == getAfter(/databases/$(database)/documents/incidentes/$(id)).data.estado
          && request.resource.data.visibilidad == getAfter(/databases/$(database)/documents/incidentes/$(id)).data.visibilidad
          && request.resource.data.respuesta == getAfter(/databases/$(database)/documents/incidentes/$(id)).data.respuesta
          && request.resource.data.fecha == request.time;
        allow update: if false;
        allow delete: if cleaning(id);
      }
    }
    match /autores/{id} {
      allow read: if signed() && (resource.data.uid == request.auth.uid || admin());
      allow create: if member() && request.resource.data.keys().hasOnly(['uid','persona','noIdentifica'])
        && request.resource.data.persona is bool && request.resource.data.noIdentifica == true
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/incidentes/$(id)).data.version == 0;
      allow update: if false;
      allow delete: if cleaning(id);
    }
    match /fotos/{id} {
      allow read: if readable(id);
      allow create: if member() && getAfter(/databases/$(database)/documents/autores/$(id)).data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/incidentes/$(id))
        && getAfter(/databases/$(database)/documents/incidentes/$(id)).data.tieneFoto == true
        && request.resource.data.keys().hasOnly(['data']) && request.resource.data.data is string
        && request.resource.data.data.size() <= 190000 && request.resource.data.data.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
      allow update: if false;
      allow delete: if cleaning(id);
    }
    match /contactos/{id} {
      allow read: if signed() && (resource.data.uid == request.auth.uid || admin());
      allow create: if member() && request.resource.data.keys().hasOnly(['uid','correo','consentimiento','creado'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.consentimiento == true
        && request.resource.data.correo is string && request.resource.data.correo.size() <= 120
        && request.resource.data.correo.matches('[^\\s@]+@[^\\s@]+[.][^\\s@]+')
        && request.resource.data.creado == request.time
        && !exists(/databases/$(database)/documents/incidentes/$(id))
        && getAfter(/databases/$(database)/documents/autores/$(id)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/incidentes/$(id)).data.version == 0;
      allow update: if false;
      allow delete: if signed() && (resource.data.uid == request.auth.uid || admin());
    }
    match /usuarios/{uid}/votos/{id} {
      allow read: if signed() && (request.auth.uid == uid || admin());
      allow create, update: if member() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['incidente','activo']) && request.resource.data.incidente == id
        && request.resource.data.activo is bool && (!exists(/databases/$(database)/documents/usuarios/$(uid)/votos/$(id)) ? request.resource.data.activo == true : request.resource.data.activo != resource.data.activo)
        && get(/databases/$(database)/documents/incidentes/$(id)).data.visibilidad == 'publico'
        && getAfter(/databases/$(database)/documents/incidentes/$(id)).data.confirmaciones == get(/databases/$(database)/documents/incidentes/$(id)).data.confirmaciones + (request.resource.data.activo ? 1 : -1);
      allow delete: if cleaning(id);
    }
    match /{path=**}/votos/{id} { allow list: if admin(); }
    match /admins/{uid} {
      allow get: if signed() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /notificaciones/{id} {
      allow read: if admin();
      allow update: if admin() && resource.data.estado == 'fallida' && request.resource.data.estado == 'pendiente'
        && request.resource.data.reintentos == resource.data.reintentos + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','reintentos']);
      allow create: if false;
      allow delete: if cleaning(resource.data.incidente) && resource.data.estado != 'enviando';
    }
    match /eliminaciones/{id} {
      allow read: if admin();
      allow create: if admin() && request.resource.data.keys().hasOnly(['solicitado'])
        && request.resource.data.solicitado == request.time
        && exists(/databases/$(database)/documents/incidentes/$(id));
      allow update: if false;
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
